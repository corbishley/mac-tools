#!/bin/bash
# Reports Claude usage, GitHub Actions spend, Render.com build minutes,
# Neon database, and Cloudflare usage.
# Reads Claude OAuth token from macOS keychain — no TUI interaction needed.
# Other API keys: read from env vars, with macOS keychain fallback.
#   Neon:       NEON_API_KEY  or  security add-generic-password -s "neon-api-key" -a "$USER" -w "key"
#   Cloudflare: CF_API_TOKEN  or  security add-generic-password -s "cloudflare-api-token" -a "$USER" -w "key"
#   Render:     RENDER_API_KEY (env only)

set -uo pipefail

trap 'printf "\r\033[K\n"; exit 130' INT

REFRESH_MINS="${1:-}"
GITHUB_ORG="${GITHUB_ORG:-}"

while true; do

# --- Get OAuth token from keychain ---
CREDS=$(security find-generic-password -s "Claude Code-credentials" -w 2>/dev/null) || {
    echo "Error: Could not read Claude credentials from keychain" >&2
    exit 1
}

TOKEN_INFO=$(python3 -c "
import sys, json
d = json.loads('''$CREDS''')['claudeAiOauth']
scopes = d.get('scopes') or ['user:profile', 'user:inference', 'user:sessions:claude_code', 'user:mcp_servers', 'user:file_upload']
print(d.get('accessToken', ''))
print(d.get('refreshToken', ''))
print(d.get('expiresAt', 0))
print(' '.join(scopes))
") || {
    echo "Error: Could not parse OAuth token" >&2
    exit 1
}
TOKEN=$(sed -n '1p' <<< "$TOKEN_INFO")
CLAUDE_REFRESH_TOKEN=$(sed -n '2p' <<< "$TOKEN_INFO")
CLAUDE_EXPIRES_AT=$(sed -n '3p' <<< "$TOKEN_INFO")
CLAUDE_SCOPES=$(sed -n '4p' <<< "$TOKEN_INFO")

# --- Refresh the Claude OAuth access token if it's expired/about to expire ---
# The access token is short-lived; normally `claude` refreshes it in the
# background on each use. If it hasn't been run in a while, mint a fresh
# access token ourselves (in-memory only — never written back to the
# keychain, so this can't collide with the real claude CLI's credential store).
CLAUDE_CLIENT_ID="9d1c250a-e61b-44d9-88ed-5944d1962f5e"

refresh_claude_token() {
    [[ -z "$CLAUDE_REFRESH_TOKEN" ]] && return 1
    local resp new_token
    resp=$(python3 -c "
import json
print(json.dumps({
    'grant_type': 'refresh_token',
    'refresh_token': '''$CLAUDE_REFRESH_TOKEN''',
    'client_id': '$CLAUDE_CLIENT_ID',
    'scope': '''$CLAUDE_SCOPES''',
}))" | curl -sf -X POST \
        -H "Content-Type: application/json" \
        --data-binary @- \
        "https://platform.claude.com/v1/oauth/token") || return 1

    new_token=$(python3 -c "
import json
try:
    print(json.loads('''$resp''').get('access_token', ''))
except Exception:
    pass
")
    [[ -z "$new_token" ]] && return 1
    TOKEN="$new_token"
    return 0
}

NOW_MS=$(($(date +%s) * 1000))
if [[ -n "$CLAUDE_EXPIRES_AT" && "$CLAUDE_EXPIRES_AT" -gt 0 && $((CLAUDE_EXPIRES_AT - NOW_MS)) -lt 60000 ]]; then
    refresh_claude_token || true
fi

# --- Keychain fallback for service API keys ---
# These supplement env vars — keychain wins if env var is empty.
if [[ -z "${NEON_API_KEY:-}" ]]; then
    NEON_API_KEY=$(security find-generic-password -s "neon-api-key" -w 2>/dev/null) || true
fi
if [[ -z "${CF_API_TOKEN:-}" ]]; then
    CF_API_TOKEN=$(security find-generic-password -s "cloudflare-api-token" -w 2>/dev/null) || true
fi
export NEON_API_KEY CF_API_TOKEN

# --- Call the Claude usage API ---
CLAUDE_API_ERROR=0
call_claude_usage() {
    curl -sf \
        -H "Authorization: Bearer $TOKEN" \
        -H "anthropic-beta: oauth-2025-04-20" \
        -H "User-Agent: claude-code/$(claude --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)" \
        "https://api.anthropic.com/api/oauth/usage"
}

RESPONSE=$(call_claude_usage) || {
    # Access token may have expired since the freshness check above — refresh and retry once.
    if refresh_claude_token && RESPONSE=$(call_claude_usage); then
        :
    else
        echo "Warning: Claude API request failed, continuing without Claude usage data" >&2
        RESPONSE='{}'
        CLAUDE_API_ERROR=1
    fi
}

# --- GitHub Actions billing ---
get_gh_actions_billing() {
    local year month data
    year=$(date +%Y)
    month=$(date +%-m)

    # Old /settings/billing/actions endpoint returned 410; use new usage API with month filter.
    # --paginate follows Link headers so we don't miss items beyond page 1.
    # --jq streams each usageItem as a separate line of NDJSON.
    data=$(gh api --paginate "/orgs/${GITHUB_ORG}/settings/billing/usage?year=${year}&month=${month}" \
        --jq '.usageItems[]?' 2>/dev/null) || {
        echo '{"total_minutes_used":0,"included_minutes":2000,"minutes_used_breakdown":{}}'
        return
    }

    echo "$data" | python3 -c "
import json, sys

# GitHub multipliers: raw runner minutes → billed minutes toward quota
MULTIPLIERS = {'UBUNTU': 1, 'WINDOWS': 2, 'MACOS': 10}

raw = {}
billed = 0.0
for line in sys.stdin:
    line = line.strip()
    if not line:
        continue
    item = json.loads(line)
    if item.get('product') != 'actions':
        continue
    qty = item.get('quantity', 0)
    sku = item.get('sku', '').lower()
    if 'linux' in sku:
        key = 'UBUNTU'
    elif 'mac' in sku:
        key = 'MACOS'
    elif 'windows' in sku:
        key = 'WINDOWS'
    else:
        key = item.get('sku', 'Other')
    raw[key] = raw.get(key, 0.0) + qty
    billed += qty * MULTIPLIERS.get(key, 1)

print(json.dumps({'total_minutes_used': billed, 'included_minutes': 2000, 'minutes_used_breakdown': raw}))
"
}

# --- Render.com build minutes ---
RENDER_ALLOWANCE=500
RENDER_INSTANCE_HOURS=750   # free instance hours, shared across the workspace; not exposed by the API

get_render_minutes() {
    # Total build time this month from build_started/build_ended events. Render
    # doesn't round per build: this tracks the dashboard figure, slightly high.
    [[ -z "${RENDER_API_KEY:-}" ]] && echo 0 && return
    python3 -c "
import json, os, re, subprocess, urllib.parse
from datetime import datetime, timezone

key = os.environ['RENDER_API_KEY']
n = datetime.now(timezone.utc)
month_start = datetime(n.year, n.month, 1, tzinfo=timezone.utc)

def get(path, **params):
    url = 'https://api.render.com/v1/' + path + '?' + urllib.parse.urlencode(params)
    out = subprocess.run(['curl', '-sf', '-H', 'Authorization: Bearer ' + key, url],
                         capture_output=True, text=True, check=True).stdout
    return json.loads(out)

def parse(s):
    # Python 3.9's fromisoformat needs exactly 3 or 6 fractional digits; Render returns 0-9
    s = s.replace('Z', '+00:00')
    s = re.sub(r'\.(\d+)', lambda m: '.' + m.group(1).ljust(6, '0')[:6], s)
    return datetime.fromisoformat(s)

total = 0.0
for svc in get('services', limit=100):
    svc_id = svc['service']['id']
    events, cursor = [], None
    while True:
        params = {'limit': 100, 'startTime': month_start.strftime('%Y-%m-%dT%H:%M:%SZ')}
        if cursor:
            params['cursor'] = cursor
        page = get('services/' + svc_id + '/events', **params)
        events += [e['event'] for e in page]
        if len(page) < 100:
            break
        cursor = page[-1]['cursor']
    started = {e['details']['buildId']: parse(e['timestamp'])
               for e in events if e['type'] == 'build_started'}
    for e in events:
        if e['type'] != 'build_ended' or e['details'].get('buildId') not in started:
            continue
        secs = max(0, (parse(e['timestamp']) - started[e['details']['buildId']]).total_seconds())
        total += secs / 60
print(round(total, 1))
" 2>/dev/null || echo 0
}

# --- Neon ---
NEON_COMPUTE_ALLOWANCE_CU_SECS=$((100 * 3600))        # 100 CU-hours per project
NEON_STORAGE_ALLOWANCE_BYTES=$((512 * 1024 * 1024))    # 0.5 GiB per project
NEON_TRANSFER_ALLOWANCE_BYTES=$((5 * 1024 * 1024 * 1024)) # 5 GiB account-wide

get_neon_projects() {
    local api_key="${NEON_API_KEY:-}"
    [[ -z "$api_key" ]] && echo '{"projects":[]}' && return

    NEON_API_KEY="$api_key" python3 << 'NEONPY'
import json, sys, os, urllib.request, urllib.error

token = os.environ.get('NEON_API_KEY', '')

def neon_get(path):
    req = urllib.request.Request(
        f'https://console.neon.tech/api/v2{path}',
        headers={'Authorization': f'Bearer {token}'}
    )
    try:
        with urllib.request.urlopen(req, timeout=15) as r:
            return json.loads(r.read()), r.status
    except urllib.error.HTTPError as e:
        return {}, e.code
    except Exception:
        return {}, 0

try:
    all_projects = []

    # Try personal projects; if the account is org-scoped the API returns 400
    data, status = neon_get('/projects?limit=100')
    if status == 200:
        all_projects.extend(data.get('projects', []))
    else:
        orgs_data, _ = neon_get('/users/me/organizations')
        for org in orgs_data.get('organizations', []):
            proj_data, _ = neon_get(f'/projects?limit=100&org_id={org["id"]}')
            all_projects.extend(proj_data.get('projects', []))

    print(json.dumps({'projects': all_projects}))
except KeyboardInterrupt:
    sys.exit(130)
NEONPY
}

get_neon_branch_storage() {
    local api_key="${NEON_API_KEY:-}"
    local project_id="$1"
    [[ -z "$api_key" ]] && echo 0 && return

    curl -sf \
        -H "Authorization: Bearer $api_key" \
        "https://console.neon.tech/api/v2/projects/${project_id}/branches" 2>/dev/null | \
        python3 -c "
import json, sys
try:
    b = json.load(sys.stdin).get('branches', [])
    print(sum(x.get('logical_size', 0) or 0 for x in b))
except:
    print(0)
" 2>/dev/null || echo 0
}

# --- Cloudflare ---
CF_PAGES_ALLOWANCE=500
CF_WORKERS_DAILY_ALLOWANCE=100000

get_cf_data() {
    local api_token="${CF_API_TOKEN:-}"
    if [[ -z "$api_token" ]]; then
        echo '{"pages_builds":0,"workers_requests":0,"has_key":false}'
        return
    fi

    CF_API_TOKEN="$api_token" python3 << 'CFPY'
import json, sys, os, urllib.request
from datetime import datetime, timezone

token = os.environ.get('CF_API_TOKEN', '')
now = datetime.now(timezone.utc)
month_start_dt = datetime(now.year, now.month, 1, tzinfo=timezone.utc)
day_start = datetime(now.year, now.month, now.day, tzinfo=timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')
day_end   = datetime(now.year, now.month, now.day, 23, 59, 59, tzinfo=timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')

def cf_get(path):
    req = urllib.request.Request(
        f'https://api.cloudflare.com/client/v4{path}',
        headers={'Authorization': f'Bearer {token}'}
    )
    try:
        with urllib.request.urlopen(req, timeout=15) as r:
            return json.loads(r.read())
    except Exception:
        return {}

try:
    # Account ID
    result = cf_get('/accounts?per_page=1').get('result', [])
    if not result:
        print(json.dumps({'pages_builds': 0, 'workers_requests': 0, 'has_key': True}))
        sys.exit(0)
    account_id = result[0]['id']

    # Pages builds this month
    total_builds = 0
    for proj in cf_get(f'/accounts/{account_id}/pages/projects?per_page=100').get('result', []):
        pname = proj['name']
        for d in cf_get(f'/accounts/{account_id}/pages/projects/{pname}/deployments?per_page=100').get('result', []):
            try:
                dt = datetime.fromisoformat(d.get('created_on', '').replace('Z', '+00:00'))
                if dt >= month_start_dt:
                    total_builds += 1
            except Exception:
                pass

    # Workers requests today via GraphQL
    workers_requests = 0
    try:
        query = json.dumps({'query': '''{
  viewer {
    accounts(filter: {accountTag: "%s"}) {
      workersInvocationsAdaptive(
        limit: 10000
        filter: {datetime_geq: "%s", datetime_leq: "%s"}
      ) { sum { requests } }
    }
  }
}''' % (account_id, day_start, day_end)})
        req = urllib.request.Request(
            'https://api.cloudflare.com/client/v4/graphql',
            data=query.encode(),
            headers={'Authorization': f'Bearer {token}', 'Content-Type': 'application/json'}
        )
        with urllib.request.urlopen(req, timeout=15) as r:
            gql = json.loads(r.read())
            for a in gql.get('data', {}).get('viewer', {}).get('accounts', []):
                for w in a.get('workersInvocationsAdaptive', []):
                    workers_requests += w.get('sum', {}).get('requests', 0)
    except Exception:
        pass

    print(json.dumps({'pages_builds': total_builds, 'workers_requests': workers_requests, 'has_key': True}))
except KeyboardInterrupt:
    sys.exit(130)
CFPY
}

printf "Fetching GitHub Actions usage..." >&2
GH_BILLING=$(get_gh_actions_billing)
GH_BILLING=${GH_BILLING:-'{"total_minutes_used":0,"included_minutes":2000,"minutes_used_breakdown":{}}'}
printf "\r\033[K" >&2

printf "Fetching Render.com usage..." >&2
RENDER_MINS=$(get_render_minutes)
RENDER_MINS=${RENDER_MINS:-0}
printf "\r\033[K" >&2

printf "Fetching Cloudflare usage..." >&2
CF_DATA=$(get_cf_data)
CF_DATA=${CF_DATA:-'{"pages_builds":0,"workers_requests":0,"has_key":false}'}
printf "\r\033[K" >&2

printf "Fetching Neon usage..." >&2
NEON_PROJECTS_RAW=$(get_neon_projects)
NEON_PROJECTS_RAW=${NEON_PROJECTS_RAW:-'{"projects":[]}'}
NEON_STORAGE_JSON="{}"
if [[ "${NEON_API_KEY:-}" != "" ]]; then
    while IFS= read -r proj_id; do
        [[ -z "$proj_id" ]] && continue
        sb=$(get_neon_branch_storage "$proj_id")
        sb=${sb:-0}
        NEON_STORAGE_JSON=$(python3 -c "
import json
m = json.loads('$NEON_STORAGE_JSON')
m['$proj_id'] = $sb
print(json.dumps(m))
") || true
        NEON_STORAGE_JSON=${NEON_STORAGE_JSON:-"{}"}
    done < <(echo "$NEON_PROJECTS_RAW" | python3 -c "
import json, sys
for p in json.load(sys.stdin).get('projects', []):
    print(p['id'])
" 2>/dev/null)
fi
printf "\r\033[K" >&2

# --- Display ---
clear
python3 << PYEOF
import json, sys, math, signal
from datetime import datetime, timedelta, timezone
signal.signal(signal.SIGINT, lambda *_: sys.exit(130))

data = json.loads('''$RESPONSE''')
claude_api_error = $CLAUDE_API_ERROR
gh_billing     = json.loads('''$GH_BILLING''')
gh_total_mins  = gh_billing.get('total_minutes_used', 0)
gh_allowance   = gh_billing.get('included_minutes', 2000)
gh_breakdown   = gh_billing.get('minutes_used_breakdown', {})
render_mins    = $RENDER_MINS
render_allowance = $RENDER_ALLOWANCE
cf_data            = json.loads('''$CF_DATA''')
neon_projects_raw  = json.loads('''$NEON_PROJECTS_RAW''')
neon_storage_map      = json.loads('''$NEON_STORAGE_JSON''')
cf_pages_allowance           = $CF_PAGES_ALLOWANCE
cf_workers_daily_allowance   = $CF_WORKERS_DAILY_ALLOWANCE
neon_compute_allowance_secs    = $NEON_COMPUTE_ALLOWANCE_CU_SECS
neon_storage_allowance_bytes   = $NEON_STORAGE_ALLOWANCE_BYTES
neon_transfer_allowance_bytes  = $NEON_TRANSFER_ALLOWANCE_BYTES

neon_projects = neon_projects_raw.get('projects', [])
now = datetime.now(timezone.utc)

def fmt_duration(secs):
    secs = int(secs)
    d = secs // 86400
    h = (secs % 86400) // 3600
    m = (secs % 3600) // 60
    if d: return f"{d}d {h}h"
    if h: return f"{h}h {m}m"
    return f"{m}m"

def fmt_when(dt):
    return f"{dt.astimezone().strftime('%a %d %b %H:%M')} ({fmt_duration((dt - now).total_seconds())})"

def runs_out(usage_frac, elapsed_secs, secs_left):
    # Extrapolates the average rate since the window started; "—" if it lasts until the reset
    if usage_frac >= 1:
        return "now"
    if usage_frac <= 0 or elapsed_secs <= 0:
        return "—"
    secs = elapsed_secs * (1 - usage_frac) / usage_frac
    if secs >= secs_left:
        return "—"
    return fmt_when(now + timedelta(seconds=secs))

def traffic_light(time_frac, usage_frac):
    elapsed_frac = 1.0 - time_frac
    diff = elapsed_frac - usage_frac
    if diff >= -0.01:
        return "🟢"
    elif diff >= -0.1:
        return "🟠"
    else:
        return "🔴"

def bar(usage_frac, elapsed_frac, width=20):
    usage_pos   = min(int(usage_frac   * width), width)
    elapsed_pos = min(int(elapsed_frac * width), width)
    chars = []
    for i in range(width):
        top = i < usage_pos
        bot = i < elapsed_pos
        if top and bot:   chars.append('█')
        elif top:         chars.append('▀')
        elif bot:         chars.append('▄')
        else:             chars.append('-')
    return "".join(chars)

# ── Table rows: ('section', title) | ('note', text) | ('row', cells) ──
rows = []

def section(title):
    rows.append(('section', title))

def note(text):
    rows.append(('note', text))

def row(light, what, usage_frac=None, elapsed_frac=None, amount='', runs='', resets='', used=None):
    if used is None:
        used = f"{usage_frac*100:.0f}%" if usage_frac is not None else ''
    rows.append(('row', [
        light,
        what,
        bar(usage_frac, usage_frac if elapsed_frac is None else elapsed_frac) if usage_frac is not None else '',
        used,
        amount,
        f"{elapsed_frac*100:.0f}%" if elapsed_frac is not None else '—',
        runs,
        resets,
    ]))

# Month boundaries
month_start_dt = datetime(now.year, now.month, 1, tzinfo=timezone.utc)
if now.month == 12:
    month_end_dt = datetime(now.year + 1, 1, 1, tzinfo=timezone.utc)
else:
    month_end_dt = datetime(now.year, now.month + 1, 1, tzinfo=timezone.utc)

month_secs     = (month_end_dt - month_start_dt).total_seconds()
elapsed_secs   = (now - month_start_dt).total_seconds()
remaining_secs = (month_end_dt - now).total_seconds()
elapsed_frac   = elapsed_secs / month_secs
time_frac      = remaining_secs / month_secs  # fraction of month still remaining
month_reset    = fmt_when(month_end_dt)

def monthly(what, usage_frac, amount):
    row(traffic_light(time_frac, usage_frac), what, usage_frac, elapsed_frac, amount,
        runs_out(usage_frac, elapsed_secs, remaining_secs), month_reset)

# ── Claude ────────────────────────────────────────────────────
def claude_window(label, d, window_secs):
    if not d or d.get('utilization') is None or not isinstance(d.get('resets_at'), str):
        return
    usage_frac = d['utilization'] / 100
    resets_at  = datetime.fromisoformat(d['resets_at'])
    secs_left  = (resets_at - now).total_seconds()
    if secs_left < 0:
        resets, secs_left = "resetting soon", 0
    else:
        resets = fmt_when(resets_at)
    w_elapsed_secs = window_secs - secs_left
    w_elapsed_frac = w_elapsed_secs / window_secs
    row(traffic_light(1 - w_elapsed_frac, usage_frac), label, usage_frac, w_elapsed_frac,
        runs=runs_out(usage_frac, w_elapsed_secs, secs_left), resets=resets)

section("Claude")
if claude_api_error:
    note("   (API request failed — check token or network)")
else:
    claude_window("5-hour", data.get("five_hour"),  5 * 3600)
    claude_window("7-day",  data.get("seven_day"), 7 * 24 * 3600)

    extra = data.get("extra_usage", {})
    if extra and extra.get("is_enabled") and extra.get("utilization") is not None:
        row('', "Extra (monthly add-on)", used=f"{extra['utilization']:.0f}%")

# ── GitHub Actions ────────────────────────────────────────────
section("GitHub Actions ($GITHUB_ORG)")
monthly("Total", gh_total_mins / gh_allowance, f"{gh_total_mins:.1f}/{gh_allowance} min")
MULT = {'Ubuntu': 1, 'Windows': 2, 'Macos': 10}
breakdown_parts = [f"{k.capitalize()} {v:.1f} min ×{MULT.get(k.capitalize(), 1)}" for k, v in gh_breakdown.items() if v]
if breakdown_parts:
    note("     " + " · ".join(breakdown_parts))

# ── Render.com ────────────────────────────────────────────────
section("Render.com ($GITHUB_ORG)")
monthly("Build", render_mins / render_allowance, f"{render_mins:.1f}/{render_allowance} min")
row("⚪", "Instance hrs", None, elapsed_frac, "?/$RENDER_INSTANCE_HOURS h",
    f"on track if ≤ {$RENDER_INSTANCE_HOURS * elapsed_frac:.0f} h", month_reset, used="?")
note("     see https://dashboard.render.com/billing")

# ── Neon ──────────────────────────────────────────────────────
section("Neon")
if not neon_projects:
    note("   (set NEON_API_KEY to see Neon usage)")
else:
    total_transfer_bytes = sum(p.get('data_transfer_bytes', 0) or 0 for p in neon_projects)

    for p in sorted(neon_projects, key=lambda p: p.get('name', p['id']).lower()):
        pname = p.get('name', p['id'])
        compute_secs = p.get('compute_time_seconds', 0) or 0
        compute_cu_h = compute_secs / 3600
        compute_frac = compute_secs / neon_compute_allowance_secs

        storage_bytes = neon_storage_map.get(p['id'], 0)
        storage_frac  = storage_bytes / neon_storage_allowance_bytes

        try:
            period_end   = datetime.fromisoformat(p['consumption_period_end'].replace('Z', '+00:00'))
            period_start = datetime.fromisoformat(p['consumption_period_start'].replace('Z', '+00:00'))
            period_secs  = (period_end - period_start).total_seconds()
            p_secs_left  = max(0.0, (period_end - now).total_seconds())
            p_elapsed_secs = period_secs - p_secs_left
            p_elapsed    = p_elapsed_secs / period_secs
            p_reset      = fmt_when(period_end) if p_secs_left > 0 else "resetting soon"
        except Exception:
            p_secs_left, p_elapsed_secs = remaining_secs, elapsed_secs
            p_elapsed    = elapsed_frac
            p_reset      = month_reset

        row(traffic_light(1 - p_elapsed, compute_frac), f"{pname} compute", compute_frac, p_elapsed,
            f"{compute_cu_h:.1f}/100 CU-h", runs_out(compute_frac, p_elapsed_secs, p_secs_left), p_reset)

        storage_mib = storage_bytes / (1024 * 1024)
        s_light = "🟢" if storage_frac < 0.7 else ("🟠" if storage_frac < 0.9 else "🔴")
        row(s_light, f"{pname} storage", storage_frac, None, f"{storage_mib:.1f}/512 MiB",
            "—", "— (persistent cap)")

    transfer_mib = total_transfer_bytes / (1024 * 1024)
    transfer_allowance_mib = neon_transfer_allowance_bytes / (1024 * 1024)
    monthly("Egress (account-wide)", total_transfer_bytes / neon_transfer_allowance_bytes,
            f"{transfer_mib:.1f}/{transfer_allowance_mib:.0f} MiB")

# ── Cloudflare ────────────────────────────────────────────────
section("Cloudflare")

cf_pages_builds   = cf_data.get('pages_builds', 0)
cf_workers_today  = cf_data.get('workers_requests', 0)
cf_has_key        = cf_data.get('has_key', False)

if not cf_has_key:
    note("   (set CF_API_TOKEN to see Cloudflare usage)")
else:
    # Pages builds — monthly limit
    monthly("Pages", cf_pages_builds / cf_pages_allowance, f"{cf_pages_builds}/{cf_pages_allowance} builds")

    # Workers requests — daily limit, resets at UTC midnight
    day_start = datetime(now.year, now.month, now.day, tzinfo=timezone.utc)
    day_end   = day_start + timedelta(days=1)
    d_elapsed = (now - day_start).total_seconds()
    w_usage_frac = cf_workers_today / cf_workers_daily_allowance
    if cf_workers_today < cf_workers_daily_allowance * 0.8:
        w_light = "🟢"
    elif cf_workers_today < cf_workers_daily_allowance:
        w_light = "🟠"
    else:
        w_light = "🔴"
    row(w_light, "Workers (today)", w_usage_frac, d_elapsed / 86400,
        f"{cf_workers_today:,}/{cf_workers_daily_allowance:,} req",
        runs_out(w_usage_frac, d_elapsed, (day_end - now).total_seconds()), fmt_when(day_end))

# ── Render table ──────────────────────────────────────────────
HEADER = ['', 'What', 'Usage', 'Used', 'Amount', 'Elapsed', 'Runs out (at current rate)', 'Resets']
cells  = [r for kind, r in rows if kind == 'row'] + [HEADER]
w      = [max(len(c[i]) for c in cells) for i in range(len(HEADER))]

def fmt_row(c):
    light = c[0] or '  '  # emoji are 2 cells wide
    return (f"{light} {c[1]:<{w[1]}}  {c[2]:<20}  {c[4]:<{w[4]}}  {c[3]:>{w[3]}}  "
            f"{c[5]:>{w[5]}}  {c[6]:<{w[6]}}  {c[7]}").rstrip()

print(fmt_row(HEADER))
for kind, r in rows:
    if kind == 'section':
        print()
        print(f"── {r} ──")
    elif kind == 'note':
        print(r)
    else:
        print(fmt_row(r))
PYEOF
echo

[[ -z "$REFRESH_MINS" ]] && break
sleep $(( REFRESH_MINS * 60 ))
done

