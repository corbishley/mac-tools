#!/usr/bin/env python3
import curses
import subprocess
import threading
import re
import sys
import time
from collections import deque

MAX_HISTORY = 10000


def ping_host(host, interval, state):
    proc = subprocess.Popen(
        ['ping', '-i', str(interval), host],
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
    )
    state['proc'] = proc
    for line in proc.stdout:
        m = re.search(r'time[=<](\d+\.?\d*)\s*ms', line)
        if m:
            val = m.group(1) + ' ms'
        elif 'timeout' in line.lower() or 'no answer' in line.lower():
            val = 'timeout'
        elif 'unreachable' in line.lower():
            val = 'unreachable'
        else:
            continue
        state['history'].append(val)
        state['dirty'] = True


def compute_stats(history, window):
    recent = list(history)[-window:]
    total = len(recent)
    if total == 0:
        return None, None, None, None
    drops = sum(1 for v in recent if v in ('timeout', 'unreachable'))
    drop_pct = (drops / total) * 100
    ms_values = sorted(
        float(v.split()[0]) for v in recent
        if v not in ('timeout', 'unreachable')
    )
    if ms_values:
        n = len(ms_values)
        median = (ms_values[n // 2 - 1] + ms_values[n // 2]) / 2 if n % 2 == 0 else ms_values[n // 2]
        avg = sum(ms_values) / n
        p95 = ms_values[min(int(0.95 * n), n - 1)]
    else:
        median = avg = p95 = None
    return median, avg, p95, drop_pct


def time_color(val):
    try:
        ms = float(val.split()[0])
        if ms < 20:
            return curses.color_pair(2)
        elif ms < 100:
            return curses.color_pair(3)
        else:
            return curses.color_pair(4)
    except (ValueError, IndexError, AttributeError):
        return curses.color_pair(4)


def main(stdscr, hosts, interval):
    curses.curs_set(0)
    stdscr.nodelay(True)
    curses.start_color()
    curses.use_default_colors()
    curses.init_pair(1, curses.COLOR_CYAN, -1)
    curses.init_pair(2, curses.COLOR_GREEN, -1)
    curses.init_pair(3, curses.COLOR_YELLOW, -1)
    curses.init_pair(4, curses.COLOR_RED, -1)

    # stats window covers ~60 seconds of pings
    stat_window = max(10, int(60 / interval))

    states = [{'history': deque(maxlen=MAX_HISTORY), 'proc': None, 'dirty': True,
                'cached_stats': (None, None, None, None)} for _ in hosts]

    for i, host in enumerate(hosts):
        t = threading.Thread(target=ping_host, args=(host, interval, states[i]), daemon=True)
        t.start()

    while True:
        # Recompute stats only when new pings have arrived
        for state in states:
            if state['dirty']:
                state['cached_stats'] = compute_stats(state['history'], stat_window)
                state['dirty'] = False

        h, w = stdscr.getmaxyx()
        col_w = w // len(hosts)
        visible = h - 8  # header + sep + med + avg + p95 + drop + sep + footer

        stdscr.erase()

        # Header
        for i, host in enumerate(hosts):
            x = i * col_w
            if i > 0:
                try:
                    stdscr.addch(0, x - 1, '│')
                except curses.error:
                    pass
            try:
                stdscr.addstr(0, x + 1, host[:col_w - 2], curses.color_pair(1) | curses.A_BOLD)
            except curses.error:
                pass

        # Separator
        try:
            stdscr.addstr(1, 0, '─' * (w - 1))
        except curses.error:
            pass

        # Stats rows — med, avg, p95, drop% over last ~60s of pings
        for i in range(len(hosts)):
            x = i * col_w
            for row in (2, 3, 4, 5):
                if i > 0:
                    try:
                        stdscr.addch(row, x - 1, '│')
                    except curses.error:
                        pass
            median, avg, p95, drop_pct = states[i]['cached_stats']
            med_str = f'med {median:.1f}ms' if median is not None else 'med ---'
            avg_str = f'avg {avg:.1f}ms' if avg is not None else 'avg ---'
            p95_str = f'p95 {p95:.1f}ms' if p95 is not None else 'p95 ---'
            drop_str = f'drp {drop_pct:.1f}%' if drop_pct is not None else 'waiting...'
            drop_color = curses.color_pair(4) if (drop_pct or 0) > 5 else curses.A_BOLD
            try:
                stdscr.addstr(2, x + 1, med_str[:col_w - 2], curses.A_BOLD)
                stdscr.addstr(3, x + 1, avg_str[:col_w - 2], curses.A_BOLD)
                stdscr.addstr(4, x + 1, p95_str[:col_w - 2], curses.A_BOLD)
                stdscr.addstr(5, x + 1, drop_str[:col_w - 2], drop_color | curses.A_BOLD)
            except curses.error:
                pass

        # Separator
        try:
            stdscr.addstr(6, 0, '─' * (w - 1))
        except curses.error:
            pass

        # Scrolling history — most recent at top
        for i in range(len(hosts)):
            x = i * col_w
            history = list(states[i]['history'])
            entries = list(reversed(history[-visible:]))

            for j, val in enumerate(entries):
                row = 7 + j
                if i > 0:
                    try:
                        stdscr.addch(row, x - 1, '│')
                    except curses.error:
                        pass
                try:
                    stdscr.addstr(row, x + 1, val[:col_w - 2], time_color(val))
                except curses.error:
                    pass

        # Footer
        try:
            stdscr.addstr(h - 1, 0, ' q: quit ', curses.A_REVERSE)
        except curses.error:
            pass

        stdscr.refresh()

        key = stdscr.getch()
        if key in (ord('q'), ord('Q'), 27):
            for state in states:
                if state['proc']:
                    state['proc'].terminate()
            break

        time.sleep(0.5)


if __name__ == '__main__':
    if len(sys.argv) < 3:
        print(f'Usage: {sys.argv[0]} <interval_secs> <host1> [host2] ...')
        sys.exit(1)

    try:
        interval = float(sys.argv[1])
    except ValueError:
        print(f'Error: interval must be a number (e.g. 1 or 0.5)')
        sys.exit(1)

    if interval < 0.2:
        print('Error: interval must be >= 0.2 seconds')
        sys.exit(1)

    try:
        curses.wrapper(main, sys.argv[2:], interval)
    except KeyboardInterrupt:
        pass
